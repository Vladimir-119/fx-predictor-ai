# Настройки fx-predictor-ai
# Скопируйте шаблон: cp .env.example .env
# В своём .env замените пароль в POSTGRES_PASSWORD и DATABASE_URL.

# PostgreSQL в Docker
POSTGRES_USER=fx_predictor
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=fx_predictor_ai

# Порт базы на компьютере. Внутри контейнера используется порт 5432.
POSTGRES_PORT=5433

# Порт приложения на компьютере при запуске через Docker Compose
APP_PORT=8000

# Подключение к базе при локальном запуске через make run
# Если меняете пользователя, пароль, имя базы или POSTGRES_PORT,
# обновите соответствующие части этого URL.
# Docker Compose собирает свой URL с адресом postgres:5432.
DATABASE_URL=postgresql://fx_predictor:change-me-before-use@localhost:5433/fx_predictor_ai

# Настройки приложения
LOG_LEVEL=INFO
ENVIRONMENT=development

# Максимальное время проверки базы, в секундах
HEALTH_TIMEOUT_SECONDS=3

# Максимальное количество подключений в пуле приложения
DB_POOL_MAX_SIZE=5
