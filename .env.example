# Настройки fx-predictor-ai
# Скопируйте шаблон: cp .env.example .env
# В своём .env замените пароль в POSTGRES_PASSWORD и DATABASE_URL.

# PostgreSQL в Docker
POSTGRES_USER=fx_predictor
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=fx_predictor_ai

# Порт базы на компьютере. Внутри контейнера используется порт 5432.
POSTGRES_PORT=5433

# Порт приложения на компьютере при запуске через Docker Compose
APP_PORT=8000

# Подключение к базе при локальном запуске через make run
# Если меняете пользователя, пароль, имя базы или POSTGRES_PORT,
# обновите соответствующие части этого URL.
# Docker Compose собирает свой URL с адресом postgres:5432.
DATABASE_URL=postgresql://fx_predictor:change-me-before-use@localhost:5433/fx_predictor_ai

# Настройки приложения
LOG_LEVEL=INFO
ENVIRONMENT=development
# Разрешённые имена API; при смене адреса добавьте его в JSON-список.
ALLOWED_HOSTS=["localhost","127.0.0.1","app"]

# Максимальное время проверки базы, в секундах
HEALTH_TIMEOUT_SECONDS=3

# Максимальное количество подключений в пуле приложения
DB_POOL_MAX_SIZE=5

# MLflow: PostgreSQL: метаданные, RustFS: файлы моделей и графики.
MLFLOW_DB=mlflow
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=fx-predictor-ai-usd-eur
MLFLOW_BUCKET=mlflow-artifacts
RUSTFS_ACCESS_KEY=fx-predictor-storage
RUSTFS_SECRET_KEY=change-this-storage-secret
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Сначала make train и make promote VERSION=..., затем make up.
# Пустой alias запускает только базовый API.
MODEL_NAME=fx-predictor-ai-forecaster
MODEL_ALIAS=champion
UPDATE_INTERVAL_SECONDS=3600

# RabbitMQ: пароль в URL должен совпадать с RABBITMQ_PASSWORD.
RABBITMQ_USER=fx_predictor
RABBITMQ_PASSWORD=change-this-rabbit-secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://fx_predictor:change-this-rabbit-secret@localhost:5672/
TASKS_QUEUE=fx-predictor-ai.tasks
QUEUE_LIMIT=20
PREFETCH_COUNT=1
WORKER_CONCURRENCY=1
INFERENCE_DELAY_SECONDS=0
TASK_MAX_ATTEMPTS=3

# Наблюдаемость отключена при обычном запуске; make obs-up включает её.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=1
OTEL_SERVICE_VERSION=0.5.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1
OTEL_BSP_SCHEDULE_DELAY=1000
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=64
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_PORT=4318

# Grafana доступна только на localhost. Замените пароль перед первым запуском.
GRAFANA_USER=admin
GRAFANA_PASSWORD=local-grafana-change-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_VERSION=13.3.1
LOKI_VERSION=3.7.10
TEMPO_VERSION=2.9.5
ALLOY_VERSION=v1.22.0
PROMETHEUS_VERSION=v3.16.0
OTEL_COLLECTOR_VERSION=0.165.0
